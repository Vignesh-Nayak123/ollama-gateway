# Copy to .env to override docker compose defaults.

# Model backend. Default is an Ollama running on the host machine.
# With `--profile bundled-ollama`, use http://ollama:11434 instead.
OLLAMA_URL=http://host.docker.internal:11434
MODEL_NAME=llama3.2:3b

# Backpressure: max requests in flight (waiting for or running on the backend).
# Request number MAX_QUEUE_SIZE+1 is rejected immediately with 503 + Retry-After.
MAX_QUEUE_SIZE=50

# Naive batching: collect up to BATCH_MAX_SIZE requests or wait BATCH_WAIT_MS, then send
# them to the backend concurrently. BATCH_MAX_SIZE=1 disables the wait (dispatch at once).
BATCH_WAIT_MS=100
BATCH_MAX_SIZE=8

# Timeouts
REQUEST_TIMEOUT_SECONDS=60
SHUTDOWN_GRACE_SECONDS=30
WARMUP_ENABLED=true
WARMUP_TIMEOUT_SECONDS=300

# Server
API_PORT=8000
LOG_LEVEL=info
# API_KEY=change-me
